# Code owners for onfire-mcp-skills.
#
# With "Require review from Code Owners" enabled on main, every PR needs an
# approving review from the developers team. Extra emphasis is documented on
# the executable + instruction surface — the parts an installer's agent will
# trust and run: SKILL.md instructions, the plugin manifest, and any hooks,
# MCP servers, or bundled scripts.

# Default: all changes require a developers review.
*                       @onfire-ai/developers

# Instruction surface (natural-language directives the agent follows).
/skills/                @onfire-ai/developers

# Plugin manifest / marketplace (declares components, hooks, MCP, allowed-tools).
/.claude-plugin/        @onfire-ai/developers

# Auto-executing / code-execution surface — review with extra care.
**/hooks.json           @onfire-ai/developers
.mcp.json               @onfire-ai/developers
**/*.mcp.json           @onfire-ai/developers
**/scripts/             @onfire-ai/developers
*.sh                    @onfire-ai/developers
*.py                    @onfire-ai/developers

# Security tooling itself.
/.gitleaks.toml         @onfire-ai/developers
/.pre-commit-config.yaml @onfire-ai/developers
